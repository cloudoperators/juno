{
  "name": "@cloudoperators/juno-app-template",
  "version": "2.0.50",
  "author": "UI-Team",
  "repository": "https://github.com/cloudoperators/juno/tree/main/apps/template",
  "license": "Apache-2.0",
  "source": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./build/index.js"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "clean": "rm -rf build && rm -rf node_modules && rm -rf .turbo",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean:cache": "rm -rf .turbo"
  },
  "dependencies": {
    "@cloudoperators/juno-ui-components": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudoperators/juno-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  }
}
