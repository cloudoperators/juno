{
  "extends": "@cloudoperators/juno-config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./build",
    "target": "ES6",
    "lib": ["ES2017", "DOM"],
    "module": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.test.ts",
    "types/**/*.ts",
    "*.config.ts",
    "*.setup.ts"
  ],
  "exclude": ["node_modules", "build"]
}
